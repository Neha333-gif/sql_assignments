--17. Write a function to calculate compound interest.

create or replace function comp_int (
    p_principal number,
    p_rate number,
    p_time number,
    p_n in number default 1
);

return number 
is
v_amount number; v_ci number;
begin
    v_amount := p_principal * power ((1+(p_rate/p_n)),(p_n*p_time));
    v_ci := v_amount - v_principal;
end;
/


