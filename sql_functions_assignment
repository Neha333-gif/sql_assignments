--14️⃣ Create a function to return the product ID with the highest total sales.  
--➡️ `get_top_product()`

create or replace function get_top_product()
return number
is 
v_prod_id number;
begin
    select 
    prod_id into v_prod_id
    from
    (select 
     prod_id, 
     sum(amount_sold) as total_sales
     from sh.sales
     group by prod_id
     order by sum(amount_sold)desc)
     where rownum = 1;
     return v_prod_id;
end;
/


