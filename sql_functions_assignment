create or replace function get_recent_sales_30days ()
return varchar2
is
v_year number; v_sold number;
begin
    select 
    extract (year from sysdate) into v_year,
    sum(amount_sold) into v_sold
    from sh.sales ;
end;
/

--28️⃣ Create a function to rank products by their total sales value (1 = highest).  
--➡️ `get_product_rank(p_prod_id NUMBER)`
create or replace function get_product_rank()
return number
is
v_rank number;
begin
    select 
    rank into v_rank
    from
    (select 
    prod_id,
    rank() over (order by sum(amount_sold) desc) as rank
    from sh.sales
    group by prod_id)
    where prod_id = p_prod_id;
    return v_rank;
end;
/


