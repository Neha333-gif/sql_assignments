--5️⃣ Create a function to calculate AMOUNT_SOLD per unit (amount / quantity) for a SALES_ID.  
--➡️ `get_amount_per_unit(p_sales_id NUMBER)`

create or replace function get_amount_per_unit(p_sales_id number)
return number 
is 
v_qty number; v_amnt number;
begin
    select 
    quantity_sold, amount_sold
    into v_qty,v_amnt
    from sh.sales 
    where sales_id = p_sales_id;
    return v_qty/v_amnt;
end;
/

 
--6️⃣ Create a function to check if a sale is 'HIGH VALUE' (>1000) or 'NORMAL'.  
--➡️ `check_sale_value(p_sales_id NUMBER)`

create or replace function check_sale_value (p_sales_id number)
return varchar2
is 
return v_amnt;
begin
    select 
    amount_sold into v_amnt 
    from sh.sales
    where sales_id = p_sales_id;
    if v_amnt > 1000 
    then
    v_status := 'high value';
    else 
    v_status := 'normal';
    end if;
    return v_status;
end;
/


