
--## 🧮 A. Basic Functions (1–10)

--1️⃣ Create a function to return total AMOUNT_SOLD for a given SALES_ID.  
--➡️ `get_sales_amount(p_sales_id NUMBER) RETURN NUMBER`

create or replace function get_sales_amount(p_sales_id number)
return number 
is 
v_amnt_sold number;
begin 
    select 
    amount_sold into v_amnt_sold 
    from sh.sales 
    where p_sales_id = sales_id;
    return v_amnt_sold;
end;
/


