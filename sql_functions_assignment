--## 🧠 C. Conditional / Logical Functions (21–25)

--21️⃣ Create a function to check if a product was ever sold (YES/NO).  
--➡️ `is_product_sold(p_prod_id NUMBER)`

create or replace function is_product_sold (p_prod_id number)
return varchar2
is
return v_sold;
begin
    select 
    prod_id,
    sum(quantity_sold) into v_sold
    from sh.sales 
    where prod_id = p_prod_id;
    if v_sold > 0 
    then
    return 'yes'
    else
    return 'no';
    end if;
end;
/

--22️⃣ Create a function to check if a customer availed any promotion.  
--➡️ `has_customer_used_promo(p_cust_id NUMBER)`


create or replace function has_customer_used_promo (p_cust_id number)
return varchar2
is
return v_promo;
begin
    select 
    max(promo_id) into v_promo
    from sh.sales
    where cust_id = p_cust_id;
    if v_promo is null 
    then return 'not_sold' 
    else
    return 'sold';
    end if;
end;
/

--23️⃣ Create a function to categorize sales value:  
--HIGH (>2000), MEDIUM (1000–2000), LOW (<1000).  
--➡️ `categorize_sale(p_sales_id NUMBER)`

create or replace function categorize_sale (p_sales_id number)
return varchar2
is
v_sale number;
begin
    select 
    amount_sold into v_sale
    from sh.sales 
    where sales_id = p_sales_id;

    if v_sale > 2000 then return 'high';
    elsif v_sale between 1000 and 2000 then return 'medium';
    elsif v_sale <1000 then return 'low';
    else return 'unknown';
    end if;
end;
/

--24️⃣ Create a function to return the difference between a product’s sale and the average sale.  
--➡️ `get_sale_diff_from_avg(p_prod_id NUMBER)`

create or replace function get_sale_diff_from_avg (p_prod_id number)
return number
is 
v_pro number; v_avg number;
begin
    select 
    prod_id,
    sum(amount_sols) into v_pro
    from sh.sales 
    where p_prod_id = prod_id;

    select 
    avg(amount_sold) into v_avg
    from sh.sales;

    return v_avg - v_pro ;
end;
/

--25️⃣ Create a function to return “LOYAL” if customer purchased more than 10 times, else “NEW”.  
--➡️ `get_customer_loyalty(p_cust_id NUMBER)`

create or replace function get_customer_loyalty (p_cust_id number)
return varchar2 
is 
v_count number;
begin
    select 
    count(*) as v_count 
    from sh.sales s
    join sh.sales p
    where s.cust_id = p.cust_id;
    if v_count > 11 
    then 
    return 'loyal' 
    else 
    return 'new';
    return v_count;
end;
/

